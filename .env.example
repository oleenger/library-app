# Copy this file to .env.local and fill in real values, then restart the dev
# server. On Vercel, set the same keys as Project Environment Variables.

# --- Supabase -------------------------------------------------------------
# Project URL and keys from Supabase → Project Settings → API.
# The URL and anon key are public (used in the browser auth flow). The
# service-role key is SECRET — server-side only, never exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# The single account allowed to sign in. Any other address is refused a magic
# link and blocked by middleware. Must match the user you create in Supabase Auth.
OWNER_EMAIL=you@example.com

# --- Anthropic ------------------------------------------------------------
# Photo intake (server-side only — never exposed to the browser).

# Anthropic API key for the vision extraction call.
ANTHROPIC_API_KEY=sk-ant-...

# A vision-capable Claude model id (held in config, not hard-coded).
# Opus reads hard spines (rotated / non-English, author-dominant typography)
# far more reliably than Sonnet, which tends to confabulate on them. Slower and
# pricier per photo, but this is a human-reviewed batch flow so accuracy wins.
INTAKE_MODEL=claude-opus-4-8

# Optional: model used to reconcile Goodreads "read" rows to library works during
# a reading import. This is a text-only cross-language title match, so Sonnet is a
# good, cheaper fit (~$0.08 vs ~$0.38 per import on Opus). Falls back to
# INTAKE_MODEL, then claude-sonnet-4-5, when unset.
READING_MATCH_MODEL=claude-sonnet-4-5

# Optional: model used for the /recommendations page. This is a reasoning- and
# taste-heavy task over the whole reading history, so it defaults to Opus. The
# call is rare — it is guarded by a reading-history fingerprint cache plus a
# cooldown, so an unchanged library never triggers a new call. Falls back to
# INTAKE_MODEL, then claude-opus-4-8, when unset.
RECOMMEND_MODEL=claude-opus-4-8
